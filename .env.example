PORT=3000
NODE_ENV=development

# Local
MONGODB_URI=mongodb://127.0.0.1:27017/nexolibro

# MongoDB Atlas (ejemplo)
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/nexolibro?retryWrites=true&w=majority

# Autenticación (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
# JWT_SECRET_PREVIOUS=secreto-anterior-solo-durante-la-rotacion
JWT_EXPIRES_IN=7d

# Opcional: mejora la cuota de Google Books para la generación automática
# GOOGLE_BOOKS_API_KEY=tu-clave-de-google-books

# Pagos con Wompi (sandbox usa pub_test_/prv_test_/test_integrity_/test_events_)
# auto: usa Wompi si están las tres llaves; si no, mantiene el modo directo sin cobro.
# wompi: exige Wompi configurado y falla si faltan llaves.
# directo: alquiler sin cobro (modo anterior).
# Configura el webhook de eventos en Wompi:
# https://TU-API.onrender.com/api/pagos/wompi/eventos
PAGOS_MODO=auto
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
# Déjalo vacío para detectar sandbox/producción según la llave pública.
WOMPI_API_URL=
WOMPI_REDIRECT_URL=https://nexolibro-eifu.vercel.app/pago/resultado

# Tarifa de alquiler: porcentaje del precio del libro por 14 días.
RENTAL_FEE_PERCENT=20
RENTAL_FEE_MIN=1500
PAGO_TTL_MINUTOS=20

# Política de vencimiento
DIAS_GRACIA=3
MULTA_DIARIA_PORCENTAJE=1
MULTA_MAXIMA_PORCENTAJE=20
MAX_RENOVACIONES=2

# Correos transaccionales con Resend
RESEND_API_KEY=
EMAIL_FROM=Nexolibro <notificaciones@tudominio.com>
APP_URL=https://nexolibro-eifu.vercel.app
ADMIN_EMAIL=elchangox720@gmail.com
